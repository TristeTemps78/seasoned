{
  "name": "voltface",
  "version": "0.0.0",
  "private": true,
  "description": "Un endroit ou l'on garde la trace de ce qu'on a pense d'une serie dans le temps",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "check:supabase": "node scripts/check-supabase.mjs",
    "db:push": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/db-push.mjs",
    "db:scenarios": "node scripts/db-scenarios.mjs",
    "db:round": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-round.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.112.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
