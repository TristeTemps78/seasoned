# Copier en `.env` et remplir. `.env` est ignore par git — le depot est public.

# TMDB — « API Read Access Token » (v4), pas la cle v3.
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Langue des metadonnees renvoyees par le catalogue.
#
# ⚠️ Laisser VIDE. Depuis le 2026-08-03, la langue du catalogue suit celle de la PAGE :
# `/serie/1396` interroge TMDB en anglais, `/fr/serie/1396` en francais. C'est ce que le
# code disait deja faire et ne faisait pas — une seule langue etait servie a tout le site.
#
# Renseigner cette variable **ecrase toutes les langues d'un coup**. Un `fr-FR` oublie en
# production servirait donc des synopsis francais sur les pages annoncees `lang="en"` —
# c'est-a-dire precisement sur celles que les moteurs indexent, le canal d'acquisition
# n°1. A n'utiliser que pour reproduire un bogue, le temps d'un essai en local.
TMDB_LANGUAGE=

# URL publique, pour les URL canoniques / robots.txt / sitemap.
# Laisser vide en local : Vercel la fournit automatiquement en deploiement.
NEXT_PUBLIC_SITE_URL=
