# Copier en `.env` et remplir. `.env` est ignore par git — le depot est public.

# TMDB — « API Read Access Token » (v4), pas la cle v3.
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Langue des metadonnees renvoyees par le catalogue.
#
# ⚠️ Laisser VIDE en temps normal : la valeur par defaut suit la langue du site
# (`DEFAULT_LOCALE` dans `lib/i18n.ts`, `en` depuis le 2026-08-02). Une valeur ecrite ici
# **surcharge** ce choix — un `fr-FR` oublie dans l'environnement de production servirait
# des synopsis francais sur des pages annoncees `lang="en"`, ce qui est la pire des deux
# options. A ne renseigner que pour forcer une langue en local, le temps d'un essai.
TMDB_LANGUAGE=

# URL publique, pour les URL canoniques / robots.txt / sitemap.
# Laisser vide en local : Vercel la fournit automatiquement en deploiement.
NEXT_PUBLIC_SITE_URL=
