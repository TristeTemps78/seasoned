# Copier en `.env` et remplir. `.env` est ignore par git — le depot est public.

# TMDB — « API Read Access Token » (v4), pas la cle v3.
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Langue des metadonnees renvoyees par le catalogue.
#
# ⚠️ Laisser cette ligne COMMENTEE — pas « vide ».
#
# Depuis le 2026-08-03 la langue du catalogue suit celle de la PAGE : `/serie/1396`
# interroge TMDB en anglais, `/fr/serie/1396` en francais. Renseigner cette variable
# **ecrase toutes les langues d'un coup** : c'est un outil pour reproduire un bogue en
# local, jamais un reglage. Un `fr-FR` oublie en production servirait des synopsis
# francais aux pages annoncees `lang="en"` — celles que les moteurs indexent.
#
# 🔴 Et la consigne precedente — « laisser VIDE » — etait elle-meme le piege :
# `TMDB_LANGUAGE=` produit une chaine vide, qui **est** une valeur. Le catalogue etait
# alors interroge sans langue, donc en anglais, y compris sur `/fr`. Corrige dans
# `lib/catalog.ts`, mais une ligne commentee ne peut plus poser la question.
# TMDB_LANGUAGE=fr-FR

# URL publique, pour les URL canoniques / robots.txt / sitemap.
# Laisser vide en local : Vercel la fournit automatiquement en deploiement.
NEXT_PUBLIC_SITE_URL=

# --- Identite de l'editeur, pour les mentions legales -------------------------
#
# ⚠️ Ces valeurs ne doivent JAMAIS etre committees : le depot est public
# (`AGENTS.md` regle 5), et un nom ou une adresse postale y resteraient dans
# l'historique meme apres suppression. Elles se renseignent dans la configuration
# de l'hebergeur, ou elles se corrigent sans redeployer le code.
#
# Tant que le nom et le courriel sont absents, `/mentions` affiche un avertissement
# au lieu d'un texte a trous : le produit ne remplit pas les cases qu'il ignore.

LEGAL_PUBLISHER_NAME=
LEGAL_CONTACT_EMAIL=

# Exigee des lors que l'activite devient commerciale — donc avant la premiere
# vente de cosmetique (arbitrage A6).
LEGAL_PUBLISHER_ADDRESS=

# Seulement s'il differe de l'editeur.
LEGAL_PUBLICATION_DIRECTOR=

# --- Supabase (lot 2b : comptes et synchronisation) --------------------------
#
# ⚠️ La cle publique (« anon » / « publishable ») est destinee au navigateur : ce
# n'est pas un secret, et elle finit de toute facon dans le bundle. C'est **RLS**
# qui protege les donnees, pas elle (`supabase/001_journal.sql`).
#
# ⛔ La cle `service_role`, elle, contourne RLS. Elle ne doit JAMAIS figurer ici,
# ni dans le code, ni dans une variable `NEXT_PUBLIC_*` — ce serait donner a
# n'importe quel visiteur la lecture de tous les journaux.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Jeton d'acces personnel (outillage local uniquement) --------------------
#
# Sert a `npm run db:push`, qui applique `supabase/*.sql` et regle les URLs de
# retour sans passer par le tableau de bord. A creer une fois sur
# https://supabase.com/dashboard/account/tokens
#
# Pourquoi il en faut un : la cle `anon` ci-dessus **ne peut pas creer une
# table** — c'est precisement ce qui la rend publiable. Appliquer un schema
# demande donc un identifiant qui, lui, le peut.
#
# ⚠️ Ce jeton vaut pour TOUT le compte Supabase : il peut creer et detruire des
# projets. Il reste ici, en local. Il ne va **pas** en secret d'integration
# continue — un jeton Supabase ne se limite pas a un projet, donc tout workflow
# ajoute plus tard pourrait le lire, et le depot est public.

SUPABASE_ACCESS_TOKEN=
